import time
from threading import Thread, Lock
import sys

lock = Lock()

def animate_text(text, delay=0.1):
    with lock:
        for char in text:
            sys.stdout.write(char)
            sys.stdout.flush()
            time.sleep(delay)
        print()

def sing_lyric(lyric, delay, speed):
    time.sleep(delay)
    animate_text(lyric, speed)

def sing_song():
    lyrics = [
        ("Tingnan natin nang husto", 0.2),
        ("Pagmasdan mo nang maigi", 0.1),
        ("Ang makulay kong mundo", 0.2),
        ("Mga tao sa paligid", 0.1),
        ("Kahit minsa'y magulo", 0.2),
        ("Kahit medyo alanganin", 0.1),
        ("Yayakapin nang buo", 0.2),
        ("Ikaw pa rin ang hahanapin", 0.1),
    ]
    delays = [0.5, 5.0, 7.0, 13.0, 15.0, 20.0, 23.0, 28.0,]
    
    threads = []
    for i in range(len(lyrics)):
        lyric, speed = lyrics[i]
        t = Thread(target=sing_lyric, args=(lyric, delays[i], speed))
        threads.append(t)
        t.start()
    
    for thread in threads:
        thread.join()

if __name__ == "__main__":
    sing_song()
